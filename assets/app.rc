#include <winver.h>

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     1,0,3,0
PRODUCTVERSION  1,0,3,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Moonkip"
            VALUE "FileDescription",  "Mpt - a minimal desktop study timer for Yeolpumta"
            VALUE "FileVersion",      "1.0.3"
            VALUE "InternalName",     "mpt"
            VALUE "OriginalFilename", "mpt.exe"
            VALUE "ProductName",      "Mpt"
            VALUE "ProductVersion",   "1.0.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
